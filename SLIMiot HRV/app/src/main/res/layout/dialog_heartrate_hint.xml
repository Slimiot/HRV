<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="10dp"
        app:cardCornerRadius="10dp"
        android:layout_margin="10dp"
        app:cardBackgroundColor="@color/white"
        app:cardMaxElevation="12dp"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="20dp"
                    android:text="Heart Rate"
                    android:fontFamily="@font/textfont"
                    android:textColor="@color/textColor"
                    android:textSize="16sp"
                    android:textStyle="bold" />


            </LinearLayout>

            <ScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="500dp"
                android:fadeScrollbars="false"
                android:layout_marginBottom="15dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="The optimal heart rate can vary depending on age, sex, and individual factors such as fitness level and overall health. Generally, the target heart rate during exercise is calculated as a percentage of maximum heart rate (HRmax) which is estimated based on age.
HRmax, or maximum heart rate, is the highest number of heartbeats per minute that an individual can achieve during exercise or physical activity. HRmax is unique to each individual and can vary based on factors such as age, sex, fitness level, and genetics.
The formula given by Dr. William Haskell and Dr. Samuel Fox for estimating maximum heart rate (HRmax) is 220 minus age. For example, for a 30-year-old, the estimated maximum heart rate would be 220 - 30 = 190 beats per minute (bpm). However there have been changes in this and different methods are used to calculate this.
Actual HRmax can be calculated using this app with help of tests given therein.
The American Heart Association (AHA) recommends a target heart rate during moderate-intensity exercise (50-70% of HRmax) for most adults, while vigorous-intensity exercise may require a target heart rate closer to 70-85% of HRmax."
                        android:fontFamily="@font/textfont"
                        android:textColor="@color/textColor"
                        android:textSize="15sp"
                        android:layout_marginTop="10dp"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="20dp"
                        android:text="Here are some general guidelines for target heart rates during exercise based on age:"
                        android:fontFamily="@font/textfont"
                        android:textColor="@color/textColor"
                        android:textSize="15sp"
                        android:layout_marginTop="5dp"
                        android:layout_marginLeft="20dp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="For adults aged 18-65 years, the AHA recommends a target heart rate range of 50-85% of HRmax, depending on fitness level and exercise goals.
\nFor adults over 65 years, the AHA recommends a target heart rate range of 50-70% of HRmax, or a perceived exertion level of 5-6 on a scale of 0-10.
\nFor children and adolescents, the AHA recommends a target heart rate range of 50-85% of HRmax, depending on age and fitness level."
                        android:fontFamily="@font/textfont"
                        android:textColor="@color/textColor"
                        android:paddingRight="5dp"
                        android:layout_marginRight="20dp"
                        android:textSize="15sp"
                        android:layout_marginTop="10dp"
                        android:layout_marginLeft="30dp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Regarding sex differences, there is no significant difference in target heart rate recommendations between men and women. However, women may have a slightly higher resting heart rate on average compared to men, which may impact target heart rate during exercise."
                        android:layout_marginRight="20dp"
                        android:fontFamily="@font/textfont"
                        android:textColor="@color/textColor"
                        android:textSize="15sp"
                        android:layout_marginTop="10dp"
                        android:layout_marginLeft="20dp"
                        android:textStyle="bold"/>


                </LinearLayout>

            </ScrollView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/okHeartRateHint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingRight="30dp"
                    android:layout_weight="1"
                    android:gravity="center|right"
                    android:text="Ok"
                    android:fontFamily="@font/textfont"
                    android:textStyle="bold"
                    android:textColor="@color/bottomNavigationColor"
                    android:textSize="15sp" />


            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>